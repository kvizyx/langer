---
source: crates/langer/tests/api.rs
expression: spec
---
{
  "components": {
    "schemas": {
      "DetectRequest": {
        "additionalProperties": false,
        "description": "Body of `POST /detect`.",
        "properties": {
          "method": {
            "$ref": "#/components/schemas/Method",
            "description": "Detection method."
          },
          "text": {
            "description": "Text to detect the language of.",
            "example": "Hi, how are you?",
            "type": "string"
          }
        },
        "required": [
          "text"
        ],
        "type": "object"
      },
      "Detection": {
        "description": "Result of a detection.",
        "properties": {
          "confidence": {
            "description": "Confidence in `0.0..=1.0`; `null` when Lingua cannot decide.",
            "example": 0.97,
            "format": "double",
            "type": [
              "number",
              "null"
            ]
          },
          "language": {
            "description": "BCP 47 tag, the same for both methods and listed by `GET /detect/languages`: an\nISO 639-1 code where one exists (`en`), else ISO 639-3 (`ceb`), with a script subtag for\nromanized text (`ru-Latn`, `mediapipe` only); `und` when no language is detected.",
            "example": "en",
            "type": "string"
          },
          "method": {
            "$ref": "#/components/schemas/Method",
            "description": "Method that produced the result."
          }
        },
        "required": [
          "language",
          "method"
        ],
        "type": "object"
      },
      "ErrorBody": {
        "description": "Body of every error response.",
        "properties": {
          "detail": {
            "description": "What went wrong.",
            "example": "Text cannot be empty",
            "type": "string"
          },
          "extra": {
            "description": "Details of the problem, if any, e.g. why the body is invalid.",
            "items": {
              "$ref": "#/components/schemas/ErrorExtra"
            },
            "type": "array"
          },
          "status_code": {
            "description": "HTTP status code of the response.",
            "example": 422,
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "status_code",
          "detail"
        ],
        "type": "object"
      },
      "ErrorExtra": {
        "description": "One detail of an error.",
        "properties": {
          "message": {
            "description": "Description of the problem.",
            "example": "missing field `text` at line 1 column 2",
            "type": "string"
          }
        },
        "required": [
          "message"
        ],
        "type": "object"
      },
      "Health": {
        "description": "Body of a successful health check.",
        "properties": {
          "status": {
            "description": "Always `ok`.",
            "example": "ok",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "type": "object"
      },
      "Language": {
        "description": "A language and the methods that can detect it.",
        "properties": {
          "code": {
            "description": "BCP 47 tag, as `POST /detect` reports it.",
            "example": "en",
            "type": "string"
          },
          "methods": {
            "description": "Methods that can return this language.",
            "items": {
              "$ref": "#/components/schemas/Method"
            },
            "type": "array"
          },
          "name": {
            "description": "English name.",
            "example": "English",
            "type": "string"
          }
        },
        "required": [
          "code",
          "name",
          "methods"
        ],
        "type": "object"
      },
      "Method": {
        "description": "Detection method requested by a client.",
        "enum": [
          "mediapipe",
          "lingua"
        ],
        "type": "string"
      }
    }
  },
  "info": {
    "description": "Self-hosted language detection HTTP service, based on Lingua and MediaPipe.",
    "license": {
      "identifier": "MIT",
      "name": "MIT"
    },
    "title": "Langer API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/detect": {
      "post": {
        "description": "`mediapipe` (default) answers in tens of microseconds, `lingua` is more accurate on one or two words but takes about a millisecond.",
        "operationId": "detect",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DetectRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Detection"
                }
              }
            },
            "description": "Detected language"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Body is not valid JSON"
          },
          "413": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Body larger than the limit"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Valid JSON with invalid fields, or empty text"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Detection failed"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Too many `lingua` detections at once; retry later"
          }
        },
        "summary": "Detect the language of a text",
        "tags": [
          "Detect"
        ]
      }
    },
    "/detect/languages": {
      "get": {
        "description": "Every language with the methods that can detect it, sorted by code.",
        "operationId": "languages",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/Language"
                  },
                  "type": "array"
                }
              }
            },
            "description": "Supported languages"
          }
        },
        "summary": "List supported languages for detection",
        "tags": [
          "Detect"
        ]
      }
    },
    "/health": {
      "get": {
        "description": "Answers `200` as long as the process runs and handles requests. It checks nothing else on purpose: a busy or shutting down service is still alive, and restarting it would not help. Whether it can take requests is `GET /health/ready`.",
        "operationId": "health",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            },
            "description": "The service is running"
          }
        },
        "summary": "Check that the service is running",
        "tags": [
          "Health"
        ]
      }
    },
    "/health/ready": {
      "get": {
        "description": "Answers `200` when the service is not shutting down and `mediapipe` detects the language of a fixed English text correctly (about 20 µs). Answers `503` once the service starts shutting down, a few seconds before it stops accepting connections (`SHUTDOWN_DELAY_SECS`), so that traffic can move to other instances; requests are still served meanwhile. Load does not affect it: excess `lingua` requests get their own `503`.",
        "operationId": "ready",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            },
            "description": "The service can take requests"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "The service is shutting down or failed its self-check"
          }
        },
        "summary": "Check that the service can take requests",
        "tags": [
          "Health"
        ]
      }
    }
  },
  "tags": [
    {
      "description": "Language detection and supported languages",
      "name": "Detect"
    },
    {
      "description": "Whether the service is running and able to serve detections",
      "name": "Health"
    }
  ]
}
