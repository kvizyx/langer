---
source: crates/langer/tests/api.rs
expression: spec
---
{
  "components": {
    "schemas": {
      "DetectRequest": {
        "additionalProperties": false,
        "description": "Body of `POST /detect`.",
        "properties": {
          "method": {
            "$ref": "#/components/schemas/Method",
            "description": "Detection method."
          },
          "text": {
            "description": "Text to detect the language of.",
            "example": "Hi, how are you?",
            "type": "string"
          }
        },
        "required": [
          "text"
        ],
        "type": "object"
      },
      "Detection": {
        "description": "Result of a detection.",
        "properties": {
          "confidence": {
            "description": "Confidence in `0.0..=1.0`, `null` with `und`.",
            "example": 0.97,
            "format": "double",
            "type": [
              "number",
              "null"
            ]
          },
          "language": {
            "description": "BCP 47 tag, the same for both methods and listed by `GET /detect/languages`: an\nISO 639-1 code where one exists (`en`), else ISO 639-3 (`ceb`), with a script subtag for\nromanized text (`ru-Latn`, `mediapipe` only); `und` when no language is detected.",
            "example": "en",
            "type": "string"
          },
          "method": {
            "$ref": "#/components/schemas/Method",
            "description": "Method that produced the result."
          }
        },
        "required": [
          "language",
          "method"
        ],
        "type": "object"
      },
      "ErrorBody": {
        "description": "Body of every error response.",
        "properties": {
          "detail": {
            "description": "What went wrong.",
            "example": "Text cannot be empty",
            "type": "string"
          },
          "extra": {
            "description": "Details of the problem, if any, e.g. why the body is invalid.",
            "items": {
              "$ref": "#/components/schemas/ErrorExtra"
            },
            "type": "array"
          },
          "status_code": {
            "description": "HTTP status code of the response.",
            "example": 422,
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "status_code",
          "detail"
        ],
        "type": "object"
      },
      "ErrorExtra": {
        "description": "One detail of an error.",
        "properties": {
          "message": {
            "description": "Description of the problem.",
            "example": "missing field `text` at line 1 column 2",
            "type": "string"
          }
        },
        "required": [
          "message"
        ],
        "type": "object"
      },
      "Health": {
        "description": "Body of a successful health check.",
        "properties": {
          "status": {
            "description": "Always `ok`.",
            "example": "ok",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "type": "object"
      },
      "Language": {
        "description": "A language and the methods that can detect it.",
        "properties": {
          "code": {
            "description": "BCP 47 tag, as `POST /detect` reports it.",
            "example": "en",
            "type": "string"
          },
          "methods": {
            "description": "Methods that can return this language.",
            "items": {
              "$ref": "#/components/schemas/Method"
            },
            "type": "array"
          },
          "name": {
            "description": "English name.",
            "example": "English",
            "type": "string"
          }
        },
        "required": [
          "code",
          "name",
          "methods"
        ],
        "type": "object"
      },
      "Method": {
        "description": "Detection method requested by a client.",
        "enum": [
          "mediapipe",
          "lingua"
        ],
        "type": "string"
      }
    }
  },
  "info": {
    "description": "Self-hosted language detection server, based on Lingua and MediaPipe.",
    "license": {
      "identifier": "MIT",
      "name": "MIT"
    },
    "title": "Langer",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/detect": {
      "post": {
        "description": "Returns the most probable language of `text` as a BCP 47 tag with its confidence. A text without letters, or one the method cannot decide on, gets `und` and a `null` confidence.",
        "operationId": "detect",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DetectRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Detection"
                }
              }
            },
            "description": "Language is detected"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Body is not valid"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Invalid fields or empty text"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "`lingua` is overloaded"
          }
        },
        "summary": "Detect the language of a text",
        "tags": [
          "Detection"
        ]
      }
    },
    "/detect/languages": {
      "get": {
        "description": "Every language with the methods that can detect it, sorted by code.",
        "operationId": "languages",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/Language"
                  },
                  "type": "array"
                }
              }
            },
            "description": "Supported languages"
          }
        },
        "summary": "List supported languages for detection",
        "tags": [
          "Detection"
        ]
      }
    },
    "/health": {
      "get": {
        "description": "Liveness probe, busy or shutting down still counts as alive.",
        "operationId": "health",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            },
            "description": "The server is running"
          }
        },
        "summary": "Check that the server is running",
        "tags": [
          "Health"
        ]
      }
    },
    "/health/ready": {
      "get": {
        "description": "Readiness probe, server can take requests unless it's shutting down or fails a quick self-check.",
        "operationId": "ready",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            },
            "description": "The server can take requests"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "The server is shutting down or failed its self-check"
          }
        },
        "summary": "Check that the server can take requests",
        "tags": [
          "Health"
        ]
      }
    }
  },
  "tags": [
    {
      "description": "Language detection and list of supported languages",
      "name": "Detection"
    },
    {
      "description": "Whether the server is running and able to serve detections",
      "name": "Health"
    }
  ]
}
